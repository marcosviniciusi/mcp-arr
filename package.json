{
  "name": "midia-mcp",
  "version": "3.2.0",
  "description": "MCP server for media stack: Sonarr, Radarr, Lidarr, Whisparr, Bazarr, Prowlarr, Autobrr, Jellyseerr, Seerr, Emby, Jellyfin, qBittorrent, NZBGet, TMDB, MyAnimeList, Ryot — with multi-instance support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "midia-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "jellyseerr",
    "sonarr",
    "radarr",
    "prowlarr",
    "qbittorrent",
    "nzbget",
    "emby",
    "arr",
    "media",
    "tmdb",
    "myanimelist",
    "ryot",
    "seerr",
    "bazarr",
    "lidarr",
    "whisparr",
    "autobrr",
    "jellyfin",
    "streamable-http"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
